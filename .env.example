# Anthropic API Key (for Claude vision models)
ANTHROPIC_API_KEY=sk-ant-...

# OpenAI API Key (for GPT-4o vision models + optional Whisper/TTS)
OPENAI_API_KEY=sk-...

# Server port (default: 3001)
PORT=3001

# Client origin for CORS (default: http://localhost:5173)
CLIENT_ORIGIN=http://localhost:5173

# Default session budget in USD (default: 0.50)
DEFAULT_BUDGET=0.50

# Log level: trace | debug | info | warn | error | fatal
LOG_LEVEL=info
